<Window x:Class="KwartoTV.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KwartoTV" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Background="{StaticResource Bg}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Margin="56,24,56,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Image Source="/Assets/kwartotv.png" Width="40" Height="40" Margin="0,0,12,0"/>
        <TextBlock Text="KwartoTV" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,36,0"/>
        <StackPanel x:Name="Nav" Orientation="Horizontal" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="PowerButton" Style="{StaticResource Pill}" Margin="0,0,18,0" Padding="16,6" ToolTip="Power">
          <TextBlock Text="⏻" FontSize="24"/>
        </Button>
        <TextBlock x:Name="RemoteDot" Text="●" FontSize="14" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock x:Name="Clock" FontSize="24" FontWeight="Light" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>

    <ContentControl x:Name="Page" Grid.Row="1" IsTabStop="False"/>

    <Grid x:Name="Overlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#D0060810">
      <Border x:Name="DialogCard" Background="{StaticResource Surface}" CornerRadius="24" BorderBrush="{StaticResource Hairline}" BorderThickness="1.5"
              HorizontalAlignment="Center" VerticalAlignment="Center" Padding="44,36" MinWidth="720" MaxWidth="1100">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="60" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
      </Border>
    </Grid>

    <Border x:Name="OskHost" Grid.RowSpan="2" Visibility="Collapsed" VerticalAlignment="Bottom"/>

    <Border x:Name="Toast" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,44"
            Background="{StaticResource Surface3}" BorderBrush="#55FF7A45" BorderThickness="1.5" CornerRadius="16" Padding="28,14">
      <Border.Effect><DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
      <TextBlock x:Name="ToastText" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1100"/>
    </Border>
  </Grid>
</Window>
